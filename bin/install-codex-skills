#!/usr/bin/env python3
"""Link every Agent Smitty skill into a Codex skill directory."""
from __future__ import annotations

import argparse
import os
import re
import sys
from pathlib import Path


NAME_FIELD = re.compile(r"^name\s*:", re.MULTILINE)
NAME_VALUE = re.compile(r"^name\s*:\s*(.*?)\s*$", re.MULTILINE)
VALID_NAME = re.compile(r"[a-z0-9][a-z0-9-]*")
ROOT = Path(__file__).resolve().parents[1]
SKILLS = ROOT / "skills"
SHARED_RESOURCES = {
    "federated-workflow": SKILLS / "engineering" / "federated-workflow",
}


class InstallError(RuntimeError):
    pass


def skill_name(skill_file: Path) -> str:
    lines = skill_file.read_text(encoding="utf-8").splitlines()
    if not lines or lines[0].strip() != "---":
        raise InstallError(f"Missing YAML front matter in {skill_file.relative_to(ROOT)}")
    try:
        closing_delimiter = next(
            index for index, line in enumerate(lines[1:], start=1) if line.strip() == "---"
        )
    except StopIteration:
        raise InstallError(
            f"Unclosed YAML front matter in {skill_file.relative_to(ROOT)}"
        ) from None

    front_matter = "\n".join(lines[1:closing_delimiter])
    if len(NAME_FIELD.findall(front_matter)) != 1:
        raise InstallError(
            f"Expected exactly one name in YAML front matter of {skill_file.relative_to(ROOT)}"
        )
    match = NAME_VALUE.search(front_matter)
    if match is None:
        raise InstallError(
            f"Invalid name in YAML front matter of {skill_file.relative_to(ROOT)}"
        )
    value = match.group(1)
    if value[:1] in {"'", '"'}:
        if len(value) < 2 or value[-1] != value[0]:
            raise InstallError(
                f"Invalid name in YAML front matter of {skill_file.relative_to(ROOT)}"
            )
        value = value[1:-1]
    elif value[-1:] in {"'", '"'}:
        raise InstallError(
            f"Invalid name in YAML front matter of {skill_file.relative_to(ROOT)}"
        )
    if VALID_NAME.fullmatch(value) is None:
        raise InstallError(
            f"Invalid name in YAML front matter of {skill_file.relative_to(ROOT)}"
        )
    return value


def skill_sources() -> dict[str, Path]:
    sources: dict[str, Path] = {}
    for skill_file in sorted(SKILLS.rglob("SKILL.md")):
        name = skill_name(skill_file)
        if name in sources:
            raise InstallError(f"Duplicate skill name: {name}")
        sources[name] = skill_file.parent.resolve()
    if not sources:
        raise InstallError("No skills found")
    return sources


def install(target: Path) -> int:
    skills = skill_sources()
    sources = skills | {
        name: source.resolve() for name, source in SHARED_RESOURCES.items()
    }
    target = target.expanduser().resolve()

    conflicts: list[str] = []
    for name, source in sources.items():
        destination = target / name
        if os.path.lexists(destination) and not (
            destination.is_symlink() and destination.resolve() == source
        ):
            conflicts.append(str(destination))
    if conflicts:
        raise InstallError("Refusing to replace existing paths: " + ", ".join(conflicts))

    target.mkdir(parents=True, exist_ok=True)
    for name, source in sources.items():
        destination = target / name
        if not os.path.lexists(destination):
            destination.symlink_to(source, target_is_directory=True)

    print(
        f"Installed {len(skills)} Codex skill links and "
        f"{len(SHARED_RESOURCES)} shared resource link in {target}"
    )
    return 0


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--target",
        type=Path,
        default=Path.home() / ".agents" / "skills",
        help="Codex skill directory, defaults to $HOME/.agents/skills",
    )
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    return install(parse_args(argv).target)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except InstallError as error:
        print(str(error), file=sys.stderr)
        raise SystemExit(1) from None
